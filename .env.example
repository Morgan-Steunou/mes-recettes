# Copier ce fichier en .env et adapter les valeurs
APP_NAME="Mes Recettes"
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (base de l'application) — également utilisé par le conteneur « db » de Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mes_recettes
POSTGRES_USER=mes_recettes
POSTGRES_PASSWORD=changez-moi
# Optionnel : URL complète, prioritaire sur les variables ci-dessus
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mes_recettes

# Variables VITE_* : les seules exposées au code Vue (navigateur)
# URL de l'API (par défaut /api, redirigé par le proxy Vite en dev)
VITE_API_URL=/api

# Comptes utilisateurs : false = application ouverte sans connexion, true = connexion obligatoire
# (créer ensuite son compte avec python -m app.cli create-user, voir README)
AUTH_ENABLED=false

# Authentification : clé de signature des tokens d'accès (obligatoire, 32 caractères minimum,
# différente pour chaque environnement). Générer une clé :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer-par-une-cle-aleatoire-de-48-caracteres-au-moins
# Token d'accès (minutes, gardé en mémoire par l'interface) et session (jours sans utilisation,
# cookie HttpOnly) : l'interface renouvelle le token d'accès tant que la session est valide
ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie de session « Secure » (HTTPS ou http://localhost) : false seulement pour un essai en HTTP
# sur une autre adresse
# REFRESH_COOKIE_SECURE=true
# Connexions échouées avant blocage (fenêtre de 15 min) : par compte et adresse IP, par adresse IP
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900

# Logs : niveau, et format (json : une ligne JSON par événement ; text : lisible).
# Par défaut : json en production, text sinon
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Migrations appliquées au démarrage de l'API. En production avec plusieurs instances :
# false, et « python -m app.cli migrate » avant le démarrage (fait par docker-compose.prod.yml)
# RUN_MIGRATIONS_ON_STARTUP=true

# ENVIRONMENT=production : l'API refuse de démarrer avec DEBUG=true ou des origines CORS
# « * » / localhost, et désactive /docs, /redoc et /openapi.json

# Production (docker-compose.prod.yml) : nom de domaine servi en HTTPS par Caddy, certificat
# Let's Encrypt automatique (le domaine doit pointer vers la machine, ports 80 et 443 ouverts).
# localhost : certificat de l'autorité interne de Caddy, pour essayer la pile sur son poste.
DOMAIN=localhost
# Sauvegarde quotidienne de la base (service « backup ») : heure UTC et durée de conservation
# BACKUP_HOUR=3
# BACKUP_KEEP_DAYS=14
