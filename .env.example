# Copier ce fichier en .env et adapter les valeurs
APP_NAME="Mes Recettes"
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (base de l'application) — également utilisé par le conteneur « db » de Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mes_recettes
POSTGRES_USER=mes_recettes
POSTGRES_PASSWORD=changez-moi
# Optionnel : URL complète, prioritaire sur les variables ci-dessus
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mes_recettes

# Variables VITE_* : les seules exposées au code Vue (navigateur)
# URL de l'API (par défaut /api, redirigé par le proxy Vite en dev)
VITE_API_URL=/api

# Authentification : clé de signature des tokens d'accès (obligatoire, 32 caractères minimum,
# différente pour chaque environnement). Générer une clé :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer-par-une-cle-aleatoire-de-48-caracteres-au-moins
ACCESS_TOKEN_EXPIRE_MINUTES=60
